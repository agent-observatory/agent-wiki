{
  "name": "agent-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix apps/web run build",
    "typecheck": "tsc --noEmit && npm --prefix apps/web run typecheck",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts && node --test tests/*.test.mjs",
    "api": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/worker/src/server.ts",
    "migrate": "tsx packages/core/src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/oauth2": "8.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4",
    "oci-common": "2.140.1",
    "oci-objectstorage": "2.140.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
