{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "apps/agent-wiki-api/src/**/*.ts",
    "apps/agent-wiki-worker/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
