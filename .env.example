DUCKDNS_DOMAIN=agent-wiki
DUCKDNS_TOKEN=

# Slack · monitoring uses the incoming webhook
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# OCI · private monitoring config JSON path (excluded from Git)
OCI_COST_CONFIG_PATH=

# OCI deployment credentials (private key stays outside repository)
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=ap-osaka-1
OCI_PRIVATE_KEY_PATH=

# GitHub login
APP_URL="https://agent-wiki.duckdns.org"
GITHUB_CALLBACK_URL="https://agent-wiki.duckdns.org/api/auth/github/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Owner-only GitHub login (numeric GitHub user ID)
OWNER_GITHUB_ID=

# Agent Wiki CLI
WIKI_TOKEN=

# Remote AI settings encryption (generate once; keep for stored API keys)
AI_ENCRYPTION_KEY=
AI_ALLOWED_HOSTS=integrate.api.nvidia.com,api.deepseek.com

# Collector uses a source:write token
WIKI_COLLECTOR_TOKEN=

# Agent management (Workspace-scoped; separate from Collector and query)
WIKI_MANAGEMENT_TOKEN=
